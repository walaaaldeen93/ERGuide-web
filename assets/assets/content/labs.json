[
  {
    "id": "hematology",
    "title": "الدمويات (Hematology)",
    "items": [
      {
        "name": "aPTT",
        "arName": "زمن التخثر الجزئي المنشط",
        "value": "25-50",
        "unit": "s",
        "note": "المجال يعتمد على الكاشف؛ العديد من المخابر الحديثة 25-35 ثا"
      },
      {
        "name": "Bleeding time",
        "arName": "زمن النزف",
